model Donation {
  id     String         @id @default(uuid())
  amount Decimal        @db.Decimal(12, 2)
  status DonationStatus @default(PENDING)

  paymentId     String?
  paymentStatus String?

  donorId String
  donor   User   @relation("DonorDonations", fields: [donorId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  requestId String
  request   DonationRequest @relation(fields: [requestId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([donorId], name: "idx_donation_donorId")
  @@index([requestId], name: "idx_donation_requestId")
  @@index([status], name: "idx_donation_status")
  @@map("donations")
}
