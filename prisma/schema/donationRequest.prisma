model DonationRequest {
  id             String  @id @default(uuid())
  title          String
  description    String
  requiredAmount Decimal @db.Decimal(12, 2)

  situationVideo String?
  situationAudio String?

  status DonationRequestStatus @default(PENDING)

  rejectionReason String?
  reviewedAt      DateTime?

  needyId String
  needy   User   @relation("NeedyRequests", fields: [needyId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  reviewedById String?
  reviewedBy   User?   @relation("ReviewedRequests", fields: [reviewedById], references: [id], onDelete: SetNull, onUpdate: Cascade)

  donations Donation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([needyId], name: "idx_donation_request_needyId")
  @@index([status], name: "idx_donation_request_status")
  @@index([reviewedById], name: "idx_donation_request_reviewedById")
  @@index([createdAt], name: "idx_donation_request_createdAt")
  @@map("donation_requests")
}
