model User {
  id       String  @id @default(uuid())
  name     String
  email    String  @unique
  password String?
  imageUrl String?
  phone    String?
  address  String?
  googleId      String?      @unique

  role          Role         @default(NEEDY)
  status        UserStatus   @default(ACTIVE)
  authProvider  AuthProvider @default(CREDENTIAL)
  emailVerified Boolean      @default(false)

  isDeleted Boolean   @default(false)
  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Profile relations
  needy Needy?
  donor Donor?
  admin Admin?

  // Donation request relations
  needyRequests    DonationRequest[] @relation("NeedyRequests")
  reviewedRequests DonationRequest[] @relation("ReviewedRequests")

  // Donation relation
  donations Donation[] @relation("DonorDonations")

  @@index([email], name: "idx_user_email")
  @@index([role], name: "idx_user_role")
  @@index([status], name: "idx_user_status")
  @@index([isDeleted], name: "idx_user_isDeleted")
  @@map("users")
}
