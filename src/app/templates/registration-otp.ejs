<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Email Verification - Daan</title>

    <style>
      body {
        font-family: Arial, sans-serif;
        background: #f7f7f7;
        color: #333;
        margin: 0;
        padding: 0;
      }

      .container {
        max-width: 500px;
        margin: 40px auto;
        background: #fff;
        padding: 30px;
        border-radius: 8px;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
        text-align: center;
      }

      .logo {
        font-size: 30px;
        font-weight: bold;
        color: #16a34a;
        margin-bottom: 20px;
      }

      .icon {
        font-size: 40px;
        margin-bottom: 10px;
      }

      h2 {
        color: #222;
        margin-bottom: 20px;
      }

      p {
        line-height: 1.6;
        font-size: 15px;
        text-align: left;
      }

      .otp {
        display: inline-block;
        padding: 14px 28px;
        background: #f0fdf4;
        color: #16a34a;
        font-size: 30px;
        font-weight: bold;
        letter-spacing: 8px;
        border-radius: 6px;
        margin: 20px 0;
      }

      .email {
        font-weight: bold;
        color: #16a34a;
      }

      .expiry {
        font-weight: bold;
      }

      .footer {
        margin-top: 30px;
        padding-top: 20px;
        border-top: 1px solid #eee;
        font-size: 12px;
        color: #888;
        text-align: center;
      }
    </style>
  </head>

  <body>
    <div class="container">
      <div class="logo"> Daan</div>

      <div class="icon">✉️</div>

      <h2>Email Verification</h2>

      <p>
        Hello <%= name %>,
      </p>

      <p>
        Welcome to <span class="email">Daan - Donate With Trust</span>.
        We received a request to create an account using this email address:
      </p>

      <p>
        <span class="email"><%= email %></span>
      </p>

      <p>
        Please use the following OTP to verify your email address:
      </p>

      <div class="otp">
        <%= otp %>
      </div>

      <p>
        This OTP will expire in
        <span class="expiry"><%= expirationMinutes %> minutes</span>.
      </p>

      <p>
        If you did not request this email verification, please ignore this
        email.
      </p>

      <div class="footer">
        Daan - Donate With Trust<br />
        Your trusted platform for meaningful giving.
      </div>
    </div>
  </body>
</html>