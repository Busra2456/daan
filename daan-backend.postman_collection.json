{
  "info": {
    "_postman_id": "daan-backend-sanitized",
    "name": "daan-backend",
    "description": "Daan — Donate with Trust. Sanitized collection: no real email, password, OTP, JWT or payment secret is included.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {"key":"baseUrl","value":"https://daan-7z6n.vercel.app/api"},
    {"key":"needy_email","value":""},
    {"key":"needy_password","value":""},
    {"key":"donor_email","value":""},
    {"key":"donor_password","value":""},
    {"key":"admin_email","value":""},
    {"key":"admin_password","value":""},
    {"key":"access_token","value":""},
    {"key":"refresh_token","value":""},
    {"key":"verification_otp","value":""},
    {"key":"reset_otp","value":""},
    {"key":"google_id_token","value":""},
    {"key":"request_id","value":""},
    {"key":"donation_id","value":""},
    {"key":"conversation_id","value":""},
    {"key":"payment_id","value":""}
  ],
  "auth": {"type":"bearer","bearer":[{"key":"token","value":"{{access_token}}","type":"string"}]},
  "item": [
    {"name":"01 Authentication","item":[
      {"name":"Register - NEEDY","request":{"method":"POST","header":[],"body":{"mode":"raw","raw":"{\n  \"name\": \"Test Needy\",\n  \"email\": \"{{needy_email}}\",\n  \"password\": \"{{needy_password}}\",\n  \"role\": \"NEEDY\"\n}","options":{"raw":{"language":"json"}}},"url":{"raw":"{{baseUrl}}/auth/register"}}},
      {"name":"Login - NEEDY","request":{"method":"POST","header":[],"body":{"mode":"raw","raw":"{\n  \"email\": \"{{needy_email}}\",\n  \"password\": \"{{needy_password}}\"\n}","options":{"raw":{"language":"json"}}},"url":{"raw":"{{baseUrl}}/auth/login"}}},
      {"name":"Register - DONOR","request":{"method":"POST","header":[],"body":{"mode":"raw","raw":"{\n  \"name\": \"Test Donor\",\n  \"email\": \"{{donor_email}}\",\n  \"password\": \"{{donor_password}}\",\n  \"role\": \"DONOR\"\n}","options":{"raw":{"language":"json"}}},"url":{"raw":"{{baseUrl}}/auth/register"}}},
      {"name":"Login - DONOR","request":{"method":"POST","header":[],"body":{"mode":"raw","raw":"{\n  \"email\": \"{{donor_email}}\",\n  \"password\": \"{{donor_password}}\"\n}","options":{"raw":{"language":"json"}}},"url":{"raw":"{{baseUrl}}/auth/login"}}},
      {"name":"Login - ADMIN","request":{"method":"POST","header":[],"body":{"mode":"raw","raw":"{\n  \"email\": \"{{admin_email}}\",\n  \"password\": \"{{admin_password}}\"\n}","options":{"raw":{"language":"json"}}},"url":{"raw":"{{baseUrl}}/auth/login"}}},
      {"name":"Verify Email","request":{"method":"POST","header":[],"body":{"mode":"raw","raw":"{\n  \"email\": \"{{needy_email}}\",\n  \"otp\": \"{{verification_otp}}\"\n}","options":{"raw":{"language":"json"}}},"url":{"raw":"{{baseUrl}}/auth/verify-email"}}},
      {"name":"Get Me","request":{"method":"GET","header":[],"url":{"raw":"{{baseUrl}}/auth/me"}}},
      {"name":"Wrong Password","request":{"method":"POST","header":[],"body":{"mode":"raw","raw":"{\n  \"email\": \"{{needy_email}}\",\n  \"password\": \"WRONG_PASSWORD_FOR_TEST\"\n}","options":{"raw":{"language":"json"}}},"url":{"raw":"{{baseUrl}}/auth/login"}}},
      {"name":"No Token","request":{"method":"GET","header":[],"url":{"raw":"{{baseUrl}}/auth/me"},"auth":{"type":"noauth"}}},
      {"name":"Forgot Password","request":{"method":"POST","header":[],"body":{"mode":"raw","raw":"{\n  \"email\": \"{{needy_email}}\"\n}","options":{"raw":{"language":"json"}}},"url":{"raw":"{{baseUrl}}/auth/forgot-password"}}},
      {"name":"Reset Password","request":{"method":"POST","header":[],"body":{"mode":"raw","raw":"{\n  \"email\": \"{{needy_email}}\",\n  \"otp\": \"{{reset_otp}}\",\n  \"newPassword\": \"{{needy_password}}\"\n}","options":{"raw":{"language":"json"}}},"url":{"raw":"{{baseUrl}}/auth/reset-password"}}},
      {"name":"Google Login","request":{"method":"POST","header":[],"body":{"mode":"raw","raw":"{\n  \"idToken\": \"{{google_id_token}}\"\n}","options":{"raw":{"language":"json"}}},"url":{"raw":"{{baseUrl}}/auth/google-login"}}},
      {"name":"Refresh Token","request":{"method":"POST","header":[],"body":{"mode":"raw","raw":"{\n  \"refreshToken\": \"{{refresh_token}}\"\n}","options":{"raw":{"language":"json"}}},"url":{"raw":"{{baseUrl}}/auth/refresh-token"}}}
    ]},
    {"name":"02 Donation Requests","item":[
      {"name":"Create Donation Request","request":{"method":"POST","header":[],"body":{"mode":"raw","raw":"{\n  \"title\": \"Education Support Needed\",\n  \"description\": \"I need financial support to continue my education and purchase necessary study materials.\",\n  \"requiredAmount\": 10000\n}","options":{"raw":{"language":"json"}}},"url":{"raw":"{{baseUrl}}/donation-requests"}}},
      {"name":"Get Donation Request","request":{"method":"GET","header":[],"url":{"raw":"{{baseUrl}}/donation-requests/{{request_id}}"}}},
      {"name":"Update Donation Request","request":{"method":"PATCH","header":[],"body":{"mode":"raw","raw":"{\n  \"title\": \"Updated Donation Request\",\n  \"description\": \"Updated description\",\n  \"requiredAmount\": 12000\n}","options":{"raw":{"language":"json"}}},"url":{"raw":"{{baseUrl}}/donation-requests/{{request_id}}"}}},
      {"name":"Delete Donation Request","request":{"method":"DELETE","header":[],"url":{"raw":"{{baseUrl}}/donation-requests/{{request_id}}"}}}
    ]},
    {"name":"03 Admin","item":[
      {"name":"Pending Donation Requests","request":{"method":"GET","header":[],"url":{"raw":"{{baseUrl}}/admin/donation-requests/pending"}}},
      {"name":"Verify Donation Request","request":{"method":"PATCH","header":[],"url":{"raw":"{{baseUrl}}/admin/donation-requests/{{request_id}}/verify"}}},
      {"name":"Reject Donation Request","request":{"method":"PATCH","header":[],"body":{"mode":"raw","raw":"{\n  \"rejectionReason\": \"Insufficient information\"\n}","options":{"raw":{"language":"json"}}},"url":{"raw":"{{baseUrl}}/admin/donation-requests/{{request_id}}/reject"}}}
    ]},
    {"name":"04 Donor","item":[
      {"name":"Verified Donation Requests","request":{"method":"GET","header":[],"url":{"raw":"{{baseUrl}}/donor/donation-requests"}}}
    ]},
    {"name":"05 Donations","item":[
      {"name":"Create Donation","request":{"method":"POST","header":[],"body":{"mode":"raw","raw":"{\n  \"amount\": 100,\n  \"requestId\": \"{{request_id}}\"\n}","options":{"raw":{"language":"json"}}},"url":{"raw":"{{baseUrl}}/donations"}}},
      {"name":"My Donations","request":{"method":"GET","header":[],"url":{"raw":"{{baseUrl}}/donations/my-donations"}}}
    ]},
    {"name":"06 Communication","item":[
      {"name":"Get Request Conversation","request":{"method":"GET","header":[],"url":{"raw":"{{baseUrl}}/communication/requests/{{request_id}}"}}},
      {"name":"Send Message","request":{"method":"POST","header":[],"body":{"mode":"raw","raw":"{\n  \"conversationId\": \"{{conversation_id}}\",\n  \"message\": \"Hello, I would like to know more about your situation.\"\n}","options":{"raw":{"language":"json"}}},"url":{"raw":"{{baseUrl}}/communication/messages"}}},
      {"name":"Get Conversation Messages","request":{"method":"GET","header":[],"url":{"raw":"{{baseUrl}}/communication/conversations/{{conversation_id}}/messages"}}}
    ]},
    {"name":"07 Payments","item":[
      {"name":"Create bKash Payment","request":{"method":"POST","header":[],"url":{"raw":"{{baseUrl}}/payments/{{donation_id}}/create"}}},
      {"name":"Execute bKash Payment","request":{"method":"POST","header":[],"body":{"mode":"raw","raw":"{\n  \"paymentID\": \"{{payment_id}}\"\n}","options":{"raw":{"language":"json"}}},"url":{"raw":"{{baseUrl}}/payments/{{donation_id}}/execute"}}},
      {"name":"bKash Callback","request":{"method":"GET","header":[],"url":{"raw":"{{baseUrl}}/payments/bkash/callback"}}}
    ]}
  ]
}
